{
  "protocol": "physiology-calibration-v1",
  "status": "preregistered-not-run",
  "purpose": "Calibrate the smallest permissible dynamics parameter set against independent neural constraints before any zero-shot odor-navigation evaluation.",
  "dataset": "male-cns:v1.0",
  "forbidden_calibration_signals": [
    "navigation_reward",
    "source_coordinates",
    "distance_to_source",
